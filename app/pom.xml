<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>io.harnesslab</groupId>
  <artifactId>harness-lab-app</artifactId>

  <!-- ==================================================================
       This version string is served by GET / at runtime.

       Bumping it, pushing, and re-running the pipeline is how the full
       CI -> CD loop is demonstrated end to end: the browser shows the new
       value at the same external IP. Keep it easy to find and change.
       ================================================================== -->
  <version>1.0.0</version>

  <name>harness-lab-app</name>
  <description>Minimal service for the Harness Implementation Engineering Lab</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Supplies /actuator/health, used by the Kubernetes readiness and
         liveness probes rather than hand-rolling a health endpoint. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Resource filtering substitutes @project.version@ in application.yml,
         so the served version always tracks the POM. Spring Boot's parent
         configures the @...@ delimiters for exactly this. -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
