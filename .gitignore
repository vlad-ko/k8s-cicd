docs/LAB-PLAN.md

# ---------------------------------------------------------------------------
# Secrets & credentials — nothing in this repo is ever authoritative for these.
# All real values live in the Harness secret manager or a local env file.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*-key.json
*credentials*.json
kubeconfig
kubeconfig-*
.kube/

# Harness delegate manifest — generated per-account, embeds an account ID and
# a delegate token. Regenerate from the Harness UI rather than committing it.
harness-delegate*.yaml
delegate.yaml

